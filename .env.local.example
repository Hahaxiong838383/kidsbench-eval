# KidsBench 本地凭据 — 复制为 .env.local 后填值
#
# 安全规则:
#   chmod 600 .env.local
#   .env.local 已在 .gitignore（不会入 git）
#   不要把这个文件 cat 到 chat / 公网 / 任何文档
#
# 用法:
#   cp .env.local.example .env.local
#   vi .env.local  # 填实际 key
#   chmod 600 .env.local
#   python -m harness.run_eval --llm-preset deepseek-v4-pro

